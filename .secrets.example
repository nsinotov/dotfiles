# ===========================================
# Dotfiles secrets — tokens only
# ===========================================
# install.sh copies this to ~/.config/dotfiles/.secrets (chmod 600) on the
# first run. Settings belong in config.sh; reference secrets there by name
# (e.g. CLAUDE_ACCOUNT_<N>_SECRET_ENV). Loaded as shell variables, not
# exported — list names in DOTFILES_EXPORT (config.sh) to export them.

# Claude proxy token (used via CLAUDE_ACCOUNT_1_SECRET_ENV in config.sh)
# CLAUDE_PROXY_TOKEN=sk-...

# Tokens used by your local extensions (~/.config/dotfiles/local/*.sh)
# ACME_API_TOKEN=...
