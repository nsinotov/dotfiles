# ===========================================
# Ghostty Terminal Configuration
# ===========================================

# ------------------------------------
# Font
# ------------------------------------

font-family = Monaspice Ne Nerd Font Mono
font-size = 14
font-style-italic = Monaspice Rn Nerd Font Mono Italic
font-style-bold-italic = Monaspice Rn Nerd Font Mono Bold Italic

# All ligatures disabled — render every character as typed
font-feature = -calt
font-feature = -liga
font-feature = -dlig
font-feature = -ss01
font-feature = -ss02
font-feature = -ss03
font-feature = -ss04
font-feature = -ss05
font-feature = -ss06
font-feature = -ss07
font-feature = -ss08
font-feature = -ss09
font-feature = -ss10

# Thicker strokes for better readability on Retina
font-thicken = true

# Extra vertical spacing between lines
adjust-cell-height = 3

# ------------------------------------
# Theme
# ------------------------------------

theme = Catppuccin Mocha

# ------------------------------------
# Cursor
# ------------------------------------

cursor-style = block
cursor-style-blink = true
adjust-cursor-thickness = 3

# ------------------------------------
# Window
# ------------------------------------

# Borderless window (works well with AeroSpace tiling)
window-decoration = false

# Slight transparency with background blur
background-opacity = 0.97
background-blur = 20

# ------------------------------------
# Behavior
# ------------------------------------

# Copy text on selection (no Cmd+C needed)
copy-on-select = true

# Shell integration for zsh (prompt markers, cwd tracking)
shell-integration = zsh
shell-integration-features = no-title

# Ask "are you sure?" before closing a surface
confirm-close-surface = true

# New windows/tabs inherit the working directory
window-inherit-working-directory = true

# ------------------------------------
# macOS Option Key
# ------------------------------------

# Left Option sends Alt/Meta (for Neovim <a-…> bindings); right Option
# still types special characters (°, ∫, etc.)
macos-option-as-alt = left

# ------------------------------------
# UA-RU Cyrillic Option-key characters
# ------------------------------------
# With macos-option-as-alt = left, Left Option bypasses macOS input composition
# and sends ESC+key instead. These bindings restore the Option+key characters
# that the Ukrainian/Russian keyboard layout defines. They only fire when the
# Cyrillic layout is active (base chars like "и" are layout-specific).
keybind = alt+и=text:ы
keybind = alt+і=text:ї
keybind = alt+е=text:ё
keybind = alt+г=text:ґ
keybind = alt+ч=text:х
keybind = alt+ь=text:ъ
keybind = alt+б=text:,
keybind = alt+ю=text:.
keybind = alt+є=text:э
keybind = shift+alt+и=text:Ы
keybind = shift+alt+і=text:Ї
keybind = shift+alt+е=text:Ё
keybind = shift+alt+г=text:Ґ
keybind = shift+alt+ч=text:Х
keybind = shift+alt+ь=text:Ъ
keybind = shift+alt+б=text:<
keybind = shift+alt+ю=text:>
keybind = shift+alt+є=text:Э

# ------------------------------------
# Keybindings
# ------------------------------------

keybind = cmd+ctrl+f=toggle_fullscreen
